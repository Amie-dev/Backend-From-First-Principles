# ═══════════════════════════════════════════════════════════════════════════════
# Day 04 — Authentication & Authorization API  ·  Environment Template
#
#   cp .env.example .env        (then edit the secrets before deploying)
#
# NEVER commit the real .env file — it is already listed in the repo .gitignore.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Number of reverse proxies in front of the app (nginx/ALB/Cloudflare).
# Required so req.ip reflects X-Forwarded-For and rate limiting cannot be bypassed.
TRUST_PROXY=1

# ─── JWT (jsonwebtoken · HS256) ───────────────────────────────────────────────
# Generate strong secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production hard-fails when these are < 32 chars or still equal to the dev default.
ACCESS_TOKEN_SECRET=dev_only_access_secret__replace_me_with_32_bytes_min
REFRESH_TOKEN_SECRET=dev_only_refresh_secret__replace_me_with_32_bytes_min
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
JWT_ISSUER=day04-auth-api
JWT_AUDIENCE=day04-client

# ─── Password hashing (bcrypt · adaptive work factor) ─────────────────────────
# 12 ≈ 250 ms/hash on modern hardware (OWASP 2024 guidance: >= 10, target ~250ms)
BCRYPT_COST=12
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_BYTES=72
PASSWORD_REQUIRE_COMPLEXITY=true

# ─── Refresh-token cookie (HttpOnly transport) ────────────────────────────────
REFRESH_COOKIE_NAME=refreshToken
REFRESH_COOKIE_PATH=/api/v1/auth
# production forces COOKIE_SECURE=true (hard-fail on boot if disabled)
COOKIE_SECURE=false
# strict | lax | none   (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
COOKIE_DOMAIN=

# ─── CORS (first-principles middleware, env-driven allowlist) ─────────────────
# Comma-separated exact origins, or "*" to allow any origin (dev only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true
CORS_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-API-Key,X-Requested-With,Accept
CORS_EXPOSED_HEADERS=X-Request-Id,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset,Retry-After
CORS_MAX_AGE_SECONDS=86400

# ─── Brute-force / credential-stuffing defences (sliding window) ──────────────
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW=1m
LOGIN_ACCOUNT_LIMIT=5
LOGIN_ACCOUNT_WINDOW=15m
REGISTER_IP_LIMIT=10
REGISTER_IP_WINDOW=1h

# ─── Reject tokens issued to deactivated users (extra DB read per request) ────
ENFORCE_USER_STATUS_ON_REQUEST=true

# ─── API keys (M2M) ───────────────────────────────────────────────────────────
API_KEY_DEFAULT_RATE_LIMIT_RPM=60

# ─── Demo data ────────────────────────────────────────────────────────────────
SEED_DEMO_DATA=true
REQUEST_BODY_LIMIT=32kb
